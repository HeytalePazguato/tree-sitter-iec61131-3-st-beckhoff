        "queries/highlights.scm"
      ]
    }
  ],
  "metadata": {
    "version": "0.0.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for Beckhoff TwinCAT 3 Structured Text, extending tree-sitter-iec61131-3-st",
    "authors": [
      {
        "name": "HeytalePazguato",
        "email": "Heytale.Pazguato@gmail.com"
      }
    ],
    "links": {
      "repository": "https://github.com/HeytalePazguato/tree-sitter-iec61131-3-st-twincat"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": true,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
